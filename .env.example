# Copy to .env and fill in — .env is gitignored.
# No VITE_ prefix on anything here: un-prefixed vars never reach the client bundle.

# Google API key (from Google Cloud Console)
GOOGLE_SEARCH_API_KEY=

# Programmable Search Engine ID (cx) — only needed for the Custom Search JSON API
GOOGLE_SEARCH_ENGINE_ID=

# Service-account JSON key for Google data APIs (Search Console, GA4, ...).
# Drop the downloaded key in the repo root as service-account.json (gitignored)
# or point this at wherever it lives. Used by scripts/gsc-report.ts.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
